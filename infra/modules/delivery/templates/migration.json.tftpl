[
  {
    "name": "migration",
    "image": "${image}",
    "essential": true,
    "stopTimeout": 40,
    "readonlyRootFilesystem": true,
    "user": "1000",
    "command": ["node", "scripts/postgresql/migrate.js"],
    "environment": ${environment},
    "secrets": ${secrets},
    "logConfiguration": {"logDriver": "awslogs", "options": ${log_options}}
  }
]
